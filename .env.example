# Copie este arquivo para .env.local (desenvolvimento) e configure as mesmas
# variáveis no painel da Vercel (Settings → Environment Variables) para produção.

# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel do Supabase → Project Settings → API → service_role (SECRETO — nunca
# exponha no navegador, usado só nas rotas /api/* do servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Magalu Cloud — Object Storage (compatível com S3), usado pelos anexos de
# Treinamentos/Documentos (certificados, exames, Ficha de EPI). Painel da
# Magalu Cloud -> Object Storage -> seu bucket -> Credenciais/Chaves de
# acesso. As duas chaves são SECRETAS — nunca exponha no navegador, usadas
# só nas rotas /api/* do servidor (src/lib/magaluStorage.ts).
# Endpoint: confirme no painel, ao lado do bucket — geralmente
# https://br-se1.magaluobjects.com (Sudeste) ou
# https://br-ne1.magaluobjects.com (Nordeste), conforme a região escolhida
# ao criar o bucket.
MAGALU_S3_ENDPOINT=https://br-se1.magaluobjects.com
MAGALU_S3_REGION=br-se1
MAGALU_S3_BUCKET=
MAGALU_S3_ACCESS_KEY=
MAGALU_S3_SECRET_KEY=

# Opcional — endpoint usado pela busca automática de CNPJ. Só precisa mudar
# se o serviço público atual (publica.cnpj.ws) sair do ar.
CNPJ_LOOKUP_BASE_URL=https://publica.cnpj.ws/cnpj

# Docsales (assinatura eletrônica válida da Ficha de EPI) — painel Docsales
# -> Configurações/Integrações (https://web.docsales.com/integrations) ->
# "Token de acesso". SECRETO — nunca exponha no navegador.
DOCSALES_API_TOKEN=
# E-mail de um usuário válido da conta Docsales da Eolen — usado como
# "criado por" ao gerar cada documento de assinatura (parâmetro user_email
# da API). Não precisa ser o mesmo e-mail que loga no Docsales
# necessariamente, só precisa existir como usuário na conta.
DOCSALES_USER_EMAIL=
# Opcional — só muda se a Docsales trocar o domínio da API.
DOCSALES_API_BASE=https://web.docsales.com/api/v1
# Segredo usado na URL do webhook (POST /api/webhooks/docsales/<este valor>)
# — como o Docsales não manda um header de autenticação customizado, esse
# segredo na própria URL é a única barreira contra alguém adivinhar o
# endpoint; ainda assim, o handler SEMPRE reconfirma o status buscando de
# volta na API Docsales antes de agir (nunca confia direto no corpo do
# webhook). Gere uma string aleatória longa (ex.: `openssl rand -hex 32`) e
# configure no painel do Docsales (Webhook -> URL) apontando pra
# https://SEU-DOMINIO/api/webhooks/docsales/<este-segredo>.
DOCSALES_WEBHOOK_SECRET=
