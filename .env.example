# Copie este arquivo para .env.local (desenvolvimento) e configure as mesmas
# variáveis no painel da Vercel (Settings → Environment Variables) para produção.

# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel do Supabase → Project Settings → API → service_role (SECRETO — nunca
# exponha no navegador, usado só nas rotas /api/* do servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — endpoint usado pela busca automática de CNPJ. Só precisa mudar
# se o serviço público atual (publica.cnpj.ws) sair do ar.
CNPJ_LOOKUP_BASE_URL=https://publica.cnpj.ws/cnpj
